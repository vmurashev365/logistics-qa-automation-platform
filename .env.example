# =============================================================================
# Logistics QA Automation Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and change what differs on your machine. NEVER commit .env.
#
# Real environment variables override .env. Every value is checked when a run starts:
# a value that cannot be read (HEADLESS=maybe, TIMEOUT=30s, BROWSER=chrome) stops the run
# with a message naming the variable. An empty value counts as unset (the default applies).
# Booleans accept true/false (also 1/0, yes/no).

# -----------------------------------------------------------------------------
# Odoo under test
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:8069
ODOO_DATABASE=logistics_qa_db

# Administrator used by the UI and the JSON-RPC client
ODOO_USERNAME=admin
ODOO_PASSWORD=admin

# Other Odoo users that a scenario signs in as by name ("I am logged in as "dispatch"")
# need a password variable: USER_<LOGIN>_PASSWORD, with the login in upper case and
# non-alphanumeric characters as "_". There is no default password.
# USER_DISPATCH_PASSWORD=

# -----------------------------------------------------------------------------
# Browser
# -----------------------------------------------------------------------------
HEADLESS=false
# chromium | firefox | webkit (install with: npx playwright install <browser>)
BROWSER=chromium
# Delay between browser actions, ms
SLOW_MO=0
# Default timeout of browser actions, ms
TIMEOUT=30000
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# -----------------------------------------------------------------------------
# Run and evidence
# -----------------------------------------------------------------------------
# Re-run a failed scenario this many times
RETRY_COUNT=0
SCREENSHOT_ON_FAILURE=true
VIDEO_RECORDING=false
# Step timing in the console, and the duration (ms) above which a step is marked SLOW
DEBUG_TIMING=true
SLOW_STEP_THRESHOLD_MS=1500
# Visual regression: true writes new baselines instead of comparing
UPDATE_BASELINE=false
# Optional suffix for test vehicle names in the fuel/inspection scenarios (RUN_SUFFIX wins;
# otherwise the last 6 characters of TEST_RUN_ID are used)
# RUN_SUFFIX=
# TEST_RUN_ID=

# -----------------------------------------------------------------------------
# PostgreSQL (direct database checks)
# -----------------------------------------------------------------------------
DB_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
POSTGRES_DATABASE=logistics_qa_db

# -----------------------------------------------------------------------------
# Odoo server log (read by @security-016: failed logins are logged only there)
# -----------------------------------------------------------------------------
# Container that runs Odoo (docker-compose.yml names it logistics-qa-odoo)
ODOO_CONTAINER=logistics-qa-odoo
# Log file inside the container (odoo.conf `logfile`). Leave empty when Odoo logs to the
# container output (no logfile, e.g. the CI `docker run`): `docker logs` is read instead.
ODOO_LOG_FILE=/var/log/odoo/odoo.log

# -----------------------------------------------------------------------------
# Mocked services
# -----------------------------------------------------------------------------
# mock | disabled
CTI_MODE=mock
# mock | disabled
OFFLINE_MODE=mock

# -----------------------------------------------------------------------------
# Integration modules (needed only by the scenarios named)
# -----------------------------------------------------------------------------
# REST services under test (finance, load status); defaults to BASE_URL
# API_BASE_URL=
# Bearer token value, without "Bearer " (financial compliance, offline sync)
API_AUTH_TOKEN=
# Paths relative to API_BASE_URL, or absolute URLs
FINANCE_SALARY_ENDPOINT=/api/finance/salary
FINANCE_IFTA_ENDPOINT=/api/finance/ifta
LOAD_STATUS_ENDPOINT=/api/loads/sync/status
# CTI screen pop: WebSocket URL to mock. A URL fragment with optional * wildcards
# (/ws/cti, wss://*/cti) or a regex literal (/wss:\/\/.*\/cti/)
CTI_WS_PATTERN=/ws/cti

# -----------------------------------------------------------------------------
# HOS / ELD (deterministic, in memory)
# -----------------------------------------------------------------------------
DEMO_MODE=true
TIMEZONE=UTC
# mock | api
ELD_MODE=mock
# Required only when ELD_MODE=api
# ELD_API_BASE_URL=
# ELD_API_TOKEN=
# FMCSA (the only ruleset implemented)
HOS_RULESET=FMCSA
